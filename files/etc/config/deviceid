config deviceid 'settings'
	option enable_mdns '1'
	option enable_service_hints '1'
	option enable_online_vendor_lookup '0'
	option online_vendor_api 'https://api.macvendors.com/'
	option online_vendor_cache '/etc/deviceid/vendor-cache.json'
	option online_vendor_ttl_days '90'
	option online_vendor_negative_ttl_days '7'
	option online_vendor_max_requests '5'
	option custom_rules '/etc/deviceid/rules.json'
	option custom_oui '/etc/deviceid/oui.json'
